{#- A Python string literal, double-quoted: the same escapes as the Rust template, which Python
    reads identically (\\ \" \r \n \t). -#}
{%- macro lit(s) -%}
"{{ s | replace("\\", "\\\\") | replace("\"", "\\\"") | replace("\r", "\\r") | replace("\n", "\\n") | replace("\t", "\\t") }}"
{%- endmacro -%}
{#- One comment line. -#}
{%- macro line(s) -%}
{{ s | trim | replace("\r", " ") | replace("\n", " ") }}
{%- endmacro -%}
{%- macro doc(a) -%}
{{ line(a.brief) }}{% if a.annotations and a.annotations.livekit and a.annotations.livekit.sensitivity == "pii" %} PII: redacted by the collector.{% endif %}{% if a.annotations and a.annotations.livekit and a.annotations.livekit.unit %} Unit: `{{ line(a.annotations.livekit.unit) }}`.{% endif %}
{%- endmacro -%}
{#- A flat module: one constant per key, enum values as KEY_VALUE constants. -#}
{%- macro attr(a) -%}
#: {{ doc(a) }}
{{ a.key | screaming_snake_case }} = {{ lit(a.key) }}
{% if a.type is mapping %}{% for m in a.type.members %}#: {{ line(m.brief) or "`" ~ m.value ~ "`." }}
{{ a.key | screaming_snake_case }}_{{ m.id | screaming_snake_case }} = {{ lit(m.value) }}
{% endfor %}{% endif %}
{%- endmacro -%}
# Code generated by weaver from livekit/protocol otel/model. DO NOT EDIT.
"""LiveKit telemetry semantic conventions."""

#: Telemetry schema version; set as `schema_url` on every OTLP scope.
SCHEMA_URL = {{ lit(ctx.schema_url) }}

{% for a in ctx.attributes %}{{ attr(a) }}
{% endfor %}
# Upstream OTel keys that LiveKit signals reference (defined by the registry's dependencies,
# never here), so a producer can name them from one place.
{% for a in ctx.upstream %}{{ attr(a) }}
{% endfor %}
# Event names (OTLP `LogRecord.event_name`).
{% for e in ctx.events %}#: {{ line(e.brief) }}
EVENT_{{ e.name | screaming_snake_case }} = {{ lit(e.name) }}
{% endfor %}
# Span names.
{% for s in ctx.spans %}#: {{ line(s.brief) }} Kind: {{ s.kind }}.
SPAN_{{ s.type | screaming_snake_case }} = {{ lit(s.type) }}
{% endfor %}
# Checkpoint names: span events of the spans above. `lk.reconnect` names its attempts
# `attempt <n> <mode>` instead.
{% for c in ctx.checkpoints %}#: {{ line(c.brief) }}
CHECKPOINT_{{ c.name | screaming_snake_case }} = {{ lit(c.name) }}
{% endfor %}{% if ctx.metrics %}
# Metric names.
{% for m in ctx.metrics %}#: {{ line(m.brief) }} Instrument: {{ m.instrument }}, unit: `{{ line(m.unit or "") }}`.
METRIC_{{ m.name | screaming_snake_case }} = {{ lit(m.name) }}
#: Unit of the instrument above, exactly as the producer creates it (empty = none).
METRIC_{{ m.name | screaming_snake_case }}_UNIT = {{ lit(m.unit or "") }}
{% endfor %}{% endif %}
