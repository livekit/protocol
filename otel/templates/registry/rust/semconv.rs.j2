{#- A Rust string literal: anything but `"`, `\` and a bare CR may appear raw; LF and tab are
    escaped too so every constant stays on one line. -#}
{%- macro lit(s) -%}
"{{ s | replace("\\", "\\\\") | replace("\"", "\\\"") | replace("\r", "\\r") | replace("\n", "\\n") | replace("\t", "\\t") }}"
{%- endmacro -%}
{#- One `///` line: a newline would end the comment. -#}
{%- macro line(s) -%}
{{ s | trim | replace("\r", " ") | replace("\n", " ") }}
{%- endmacro -%}
{%- macro doc(a) -%}
{{ line(a.brief) }}{% if a.annotations and a.annotations.livekit and a.annotations.livekit.sensitivity == "pii" %} PII: redacted by the collector.{% endif %}{% if a.annotations and a.annotations.livekit and a.annotations.livekit.unit %} Unit: `{{ line(a.annotations.livekit.unit) }}`.{% endif %}
{%- endmacro -%}
{#- An attribute constant with, for an enum, a module of its values. -#}
{%- macro attr(a) -%}
/// {{ doc(a) }}
pub const {{ a.key | screaming_snake_case }}: &str = {{ lit(a.key) }};
{% if a.type is mapping %}
/// Values of [`{{ a.key | screaming_snake_case }}`].
pub mod {{ a.key | snake_case }} {
{% for m in a.type.members %}    /// {{ line(m.brief) or "`" ~ m.value ~ "`." }}
    pub const {{ m.id | screaming_snake_case }}: &str = {{ lit(m.value) }};
{% endfor %}}
{% endif %}
