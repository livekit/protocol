{%- endmacro -%}
{#- An attribute key constant. Go has no namespaces, so an enum's or shipped-value key's values each
    become a top-level constant named <PascalKey><PascalMemberId>, next to the key constant. -#}
{%- macro attr(a) -%}
{%- set name = "Attr" ~ (a.key | pascal_case) -%}
// {{ name }} is the {{ lit(a.key) }} attribute: {{ doc(a) }}
const {{ name }} = {{ lit(a.key) }}
{% for m in (a.type.members if a.type is mapping else []) %}
// {{ a.key | pascal_case }}{{ m.id | pascal_case }} is a value of {{ name }}: {{ line(m.brief) or line("`" ~ m.value ~ "`.") }}
const {{ a.key | pascal_case }}{{ m.id | pascal_case }} = {{ lit(m.value) }}
{% endfor %}{% for v in a.shipped_values or [] %}
// {{ a.key | pascal_case }}{{ v.id | pascal_case }} is a value of {{ name }}: {{ line(v.brief) }} Sent by LiveKit, not an upstream value.
const {{ a.key | pascal_case }}{{ v.id | pascal_case }} = {{ lit(v.value) }}
{% endfor %}
{%- endmacro -%}
