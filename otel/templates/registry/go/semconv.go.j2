"{{ s | replace("\\", "\\\\") | replace("\"", "\\\"") | replace("\r", "\\r") | replace("\n", "\\n") | replace("\t", "\\t") }}"
{%- endmacro -%}
{#- One `//` doc line: a newline would break the comment. -#}
{%- macro line(s) -%}
{{ s | trim | replace("\r", " ") | replace("\n", " ") }}
{%- endmacro -%}
{%- macro doc(a) -%}
